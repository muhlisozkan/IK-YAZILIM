BORDRO_ENV_FILE=/dev/null
SMTP_SETTINGS_KEY=replace-with-at-least-32-random-characters

# Anket / Make It Right davet linklerinde kullanılacak genel adres
PUBLIC_BASE_URL=https://hr.adminpanel.space

# Oturum çerezi Secure bayrağı: auto (yalnızca HTTPS isteklerde) | true | false
COOKIE_SECURE=auto
# Giriş kaba kuvvet koruması
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
